web: gunicorn advance_company.wsgi:application --bind 0.0.0.0:$PORT --workers 4 --threads 2 --timeout 300 --graceful-timeout 300 --keep-alive 10 --max-requests 1000 --max-requests-jitter 50 --worker-class sync --worker-tmp-dir /dev/shm --access-logfile - --error-logfile - --log-level info
release: python manage.py migrate && python manage.py collectstatic --noinput && python manage.py create_admin