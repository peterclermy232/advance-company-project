from django.core.management.base import BaseCommand
from django.db import connection, transaction
from django.apps import apps
import logging

logger = logging.getLogger(__name__)


class Command(BaseCommand):
    help = 'Migrate all models from id to uuid as primary key'

    def add_arguments(self, parser):
        parser.add_argument(
            '--dry-run',
            action='store_true',
            help='Show what would be done without executing',
        )
        parser.add_argument(
            '--execute',
            action='store_true',
            help='Execute the migration (DESTRUCTIVE)',
        )

    def handle(self, *args, **options):
        if not options['dry_run'] and not options['execute']:
            self.stdout.write(
                self.style.ERROR(
                    'You must specify either --dry-run or --execute'
                )
            )
            return

        dry_run = options['dry_run']

        if dry_run:
            self.stdout.write(
                self.style.WARNING('\n=== DRY RUN MODE - No changes will be made ===\n')
            )
        else:
            self.stdout.write(
                self.style.ERROR('\n=== EXECUTING MIGRATION - THIS WILL MODIFY YOUR DATABASE ===\n')
            )
            confirm = input('Type "yes" to confirm: ')
            if confirm != 'yes':
                self.stdout.write(self.style.ERROR('Migration cancelled'))
                return

        # Models to migrate (app_label, model_name)
        models_to_migrate = [
            ('accounts', 'User'),
            ('accounts', 'BiometricDevice'),
            ('accounts', 'BiometricAuthLog'),
            ('financial', 'FinancialAccount'),
            ('financial', 'Deposit'),
            ('financial', 'InterestCalculation'),
            ('beneficiary', 'Beneficiary'),
            ('documents', 'Document'),
            ('applications', 'Application'),
            ('applications', 'ApplicationActivity'),
            ('notifications', 'Notification'),
            ('reports', 'Report'),
            ('reports', 'ActivityLog'),
        ]

        self.stdout.write('\n=== MIGRATION PLAN ===\n')
        
        for app_label, model_name in models_to_migrate:
            try:
                Model = apps.get_model(app_label, model_name)
                table_name = Model._meta.db_table
                
                self.stdout.write(f'\n{model_name} ({table_name}):')
                self.stdout.write(f'  1. Remove primary key from id')
                self.stdout.write(f'  2. Set uuid as primary key')
                self.stdout.write(f'  3. Drop id column')
                self.stdout.write(f'  4. Update foreign key references')
                
            except LookupError:
                self.stdout.write(
                    self.style.ERROR(f'✗ Model {app_label}.{model_name} not found')
                )

        if dry_run:
            self.stdout.write(
                self.style.WARNING('\n=== DRY RUN COMPLETE - No changes made ===\n')
            )
            return

        # Execute migration
        self.stdout.write('\n=== EXECUTING MIGRATION ===\n')
        
        with connection.cursor() as cursor:
            try:
                with transaction.atomic():
                    for app_label, model_name in models_to_migrate:
                        Model = apps.get_model(app_label, model_name)
                        table_name = Model._meta.db_table
                        
                        self.stdout.write(f'\nMigrating {model_name}...')
                        
                        # Step 1: Remove primary key constraint from id
                        self.stdout.write('  Removing primary key from id...')
                        cursor.execute(f'''
                            ALTER TABLE {table_name} 
                            DROP CONSTRAINT {table_name}_pkey CASCADE;
                        ''')
                        
                        # Step 2: Make uuid the primary key
                        self.stdout.write('  Setting uuid as primary key...')
                        cursor.execute(f'''
                            ALTER TABLE {table_name} 
                            ADD PRIMARY KEY (uuid);
                        ''')
                        
                        # Step 3: Drop the id column
                        self.stdout.write('  Dropping id column...')
                        cursor.execute(f'''
                            ALTER TABLE {table_name} 
                            DROP COLUMN id;
                        ''')
                        
                        self.stdout.write(
                            self.style.SUCCESS(f'  ✓ {model_name} migrated successfully')
                        )
                
                self.stdout.write(
                    self.style.SUCCESS('\n=== MIGRATION COMPLETED SUCCESSFULLY ===\n')
                )
                
            except Exception as e:
                self.stdout.write(
                    self.style.ERROR(f'\n✗ Migration failed: {str(e)}\n')
                )
                self.stdout.write(
                    self.style.ERROR('Transaction rolled back - no changes made')
                )
                raise

        self.stdout.write('\n=== POST-MIGRATION TASKS ===')
        self.stdout.write('1. Update all model files to remove id field')
        self.stdout.write('2. Update serializers to use uuid instead of id')
        self.stdout.write('3. Update frontend to use uuid for API calls')
        self.stdout.write('4. Run tests to verify everything works')
        self.stdout.write('5. Create a new migration file to reflect model changes\n')